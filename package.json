{
  "name": "whipper-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.21.0", "npm": "11.19.0" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node scripts/prepare.mjs && astro dev --host 127.0.0.1 --ignore-lock",
    "check": "astro check && tsx --test tests/catalog.test.ts",
    "build": "node scripts/prepare.mjs && astro build && node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1 --ignore-lock",
    "test:browser": "node scripts/browser-tests.mjs"
  },
  "dependencies": { "astro": "7.4.11", "csv-parse": "7.0.3" },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}

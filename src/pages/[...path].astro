---
import { getCollection, render } from 'astro:content';
import Wiki from '../layouts/Wiki.astro';
import Home from '../components/Home.astro';
import Search from '../components/Search.astro';
import { referenceRoutes, type Route } from '../lib/routes';
import { categories, catalog, snapshot, translationRows, duplicateTranslationKeys, number, entryHref, entryName, translate, factLabel, icon } from '../lib/catalog';
import { href, base, ui } from '../lib/site';
import analysisNotes from '../../data/analysis-notes.json';
import rawBossNotes from '../../data/boss-notes.json';
import dungeonCodes from '../../data/random-keys.json';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return referenceRoutes(guides.map(guide => guide.id));
}
type Props = Route['props'];
const { locale, path, page } = Astro.props;
const guides = (await getCollection('guides')).sort((a,b) => a.data.order - b.data.order);
const guide = page.kind === 'guide' ? guides.find(guide => guide.id === page.id) : undefined;
const rendered = guide ? await render(guide) : undefined;
const Content = rendered?.Content;
const title = page.kind === 'home' ? 'Whipper Wiki'
  : page.kind === 'catalog' ? ui(locale, page.category)
  : page.kind === 'entry' ? translate(page.entry.nameKey, locale)
  : page.kind === 'guide' ? guide!.data.title
  : page.kind === 'dungeon-codes' ? 'Dungeon codes'
  : page.kind === 'analysis' ? 'Analysis reference'
  : ui(locale, page.kind);
const description = guide?.data.description || (page.kind === 'entry' && page.entry.summaryKey ? translate(page.entry.summaryKey, locale) : `${title} — Whipper ${snapshot.gameVersion} game reference, related equipment, enemies and beginner guides.`);
const bossNotes: Record<string, typeof rawBossNotes['200']> = rawBossNotes;
const boss = page.kind === 'entry' && page.entry.category === 'bosses' ? bossNotes[String(page.entry.id)] : undefined;
const tools = [
  { file: 'item-book', title: 'Item Book', text: 'Manually track equipment analysis and BP. Browser-local records; no automatic game connection.' },
  { file: 'build-maker', title: 'Build Maker', text: 'Create and export local build ideas. Calculations are experimental and do not check your owned inventory.' },
  { file: 'fight-sim', title: 'Fight Simulator', text: 'Explore dungeon runs. XP, encounters and special effects are incomplete; a simulated clear is not a reliable prediction.' },
  { file: 'compare', title: 'Equipment Comparison', text: 'Compare base equipment properties. Treat derived ratings as exploratory.' },
  { file: 'damage', title: 'Damage Calculator', text: 'Explore the older damage model. Formula order and current-version parity remain unverified.' },
];
---
<Wiki locale={locale} title={title} description={description} path={path} guide={page.kind === 'guide'}>
  {page.kind === 'home' ? <Home locale={locale} /> : <div class="wrap page-content">
    <header class="page-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
<a href={href(locale)}>{ui(locale,'home')}</a>
<span aria-hidden="true">/</span>{page.kind === 'entry' && <>
<a href={href(locale,page.entry.category)}>{ui(locale,page.entry.category)}</a>
<span aria-hidden="true">/</span>
</>}<span>{title}</span>
</nav>
      {page.kind === 'entry' ? <div class="entity-title">{page.entry.icon && <img src={icon(page.entry)} alt="" width="80" height="80" />}<div>
<p class="eyebrow">{ui(locale,page.entry.category)} · #{page.entry.id}</p>
<h1>{title}</h1>
</div>
</div> : <>
<p class="eyebrow">WHIPPER WIKI</p>
<h1 lang={page.kind === 'guide' || page.kind === 'analysis' || page.kind === 'dungeon-codes' ? 'en' : undefined}>{title}</h1>
</>}
      {guide && <p lang="en">{guide.data.description}</p>}
    </header>

    {page.kind === 'reference' && <>
<p lang="en">Browse the complete captured catalogs. Follow an entry to its stats, effects and related equipment, enemies or dungeons.</p>
<div class="category-grid">{categories.map(category => <a class="category-card" href={href(locale,category)}>
<div>
<h2>{ui(locale,category)}</h2>
<span>{catalog(category).length} {ui(locale,'results')}</span>
</div>
<span class="entry-arrow" aria-hidden="true">↗</span>
</a>)}</div>
<div class="notice" lang="en">Base data is from Android {snapshot.gameVersion}, build {snapshot.build}. It does not include every runtime scaling rule or special reward. <a href={href(locale,'coverage')}>See what is covered.</a>
</div>
</>}
    {page.kind === 'search' && <Search locale={locale} />}
    {page.kind === 'catalog' && <>
<nav class="category-nav" aria-label={ui(locale,'reference')}>{categories.map(category => <a href={href(locale,category)} aria-current={page.category === category ? 'page' : undefined}>{ui(locale,category)}</a>)}</nav>
<p class="small-note" lang="en">{page.category === 'enchantments' ? `${snapshot.tables.customs.records} recorded ability/level definitions, grouped into ${catalog('enchantments').length} abilities. Each page includes all recorded levels.` : 'Base game data. Individual equipment, special encounters and progression modifiers can change the values you see in play.'}</p>{page.category === 'dungeons' && <p class="small-note" lang="en">
<a class="text-link" href={href(locale,'dungeon-codes')}>Community dungeon codes ↗</a> · <a class="text-link" href={href(locale,'guides/progression')}>Progression guide ↗</a>
</p>}<Search locale={locale} category={page.category} />
</>}

    {page.kind === 'entry' && <div class="entity-grid">
<div>
      {page.entry.summaryKey && <div class="panel">
<h2>{ui(locale,'effect')}</h2>
<p class="entity-description">{translate(page.entry.summaryKey,locale)}</p>
</div>}
      {page.entry.facts.length > 0 && <section class="panel">
<h2>{ui(locale,'gameData')}</h2>
<dl class="facts">{page.entry.facts.map(fact => <div>
<dt>{factLabel(fact.label,locale)}</dt>
<dd>{typeof fact.value === 'number' ? number(fact.value,locale) : fact.translate ? translate(fact.value,locale) : fact.value}</dd>
</div>)}</dl>
</section>}
      {page.entry.levels.length > 0 && <div class="table-scroll">
<table>
<caption class="sr-only">{title} — {ui(locale,'level')}</caption>
<thead>
<tr>
<th scope="col">{ui(locale,'level')}</th>
<th scope="col">{ui(locale,'value')}</th>
<th scope="col">{ui(locale,'effect')}</th>
<th scope="col">ID</th>
</tr>
</thead>
<tbody>{page.entry.levels.map(level => <tr id={`level-${level.id}`}>
<th scope="row">{number(level.level,locale)}</th>
<td>{number(level.value,locale)}</td>
<td>{translate(level.summaryKey,locale)}</td>
<td>{level.id}</td>
</tr>)}</tbody>
</table>
</div>}
      {page.entry.category === 'dungeons' && <>
<div class="notice" lang="en">Listed base encounter data, not a complete generated adventure. Boss placement, repeating Royal Tomb groups, random dungeons and special events can follow additional rules.</div>
<div class="table-scroll">
<table>
<caption class="sr-only">{title} — {ui(locale,page.entry.category === 'dungeons' && page.entry.id === 12 ? 'encounterGroups' : 'floors')}</caption>
<thead>
<tr>
<th scope="col">{ui(locale,page.entry.category === 'dungeons' && page.entry.id === 12 ? 'encounterGroups' : 'floors')}</th>
<th scope="col">{ui(locale,'monsters')}</th>
</tr>
</thead>
<tbody>{page.entry.floors.map(row => <tr>
<th scope="row">{row.floor}</th>
<td>
<div class="floor-links">{row.targets.map(target => <a href={entryHref(target,locale)}>{entryName(target,locale)}</a>)}</div>
</td>
</tr>)}</tbody>
</table>
</div>
</>}
      {boss && <section class="panel" lang="en">
<p class="eyebrow">{ui(locale,'journal')}</p>
<h2>Special rules & strategy</h2>
<p class="small-note">Retained from the earlier wiki. These exact phases, percentages and recommendations have not been independently verified against 7.3.1. Base data above has a different evidence source.</p>
<p>
<strong>Reported attack types:</strong> {boss.attackType}</p>
<p>
<strong>Reported reward:</strong> {boss.dropItem}</p>
<p>
<strong>{boss.proofName}:</strong> {boss.proofEffect}</p>{boss.phases.map(phase => <div>
<h3>{phase.hpThreshold}</h3>
<ul>{phase.effects.map(effect => <li>{effect}</li>)}</ul>
</div>)}<h3>Earlier recommendations</h3>
<ul>{boss.recommendations.map(note => <li>{note}</li>)}</ul>
<a class="text-link" href={href(locale,'guides/bosses')}>How to approach a boss ↗</a>
</section>}
      <p class="small-note" lang="en">Source: Android {snapshot.gameVersion}, build {snapshot.build}, captured {snapshot.capturedAt}. Values are base definitions; the game may apply additional modifiers. Listed drops are not guaranteed and may not describe every reward source.</p>
    </div>
<aside>
<section class="panel">
<h2>{ui(locale,'sources')}</h2>{page.entry.relations.length ? <ul class="relation-list">{page.entry.relations.map(relation => <li>
<small>{ui(locale,relation.label)}</small>
<a href={`${entryHref(relation.target,locale)}${relation.variantId ? `#level-${relation.variantId}` : ''}`}>{entryName(relation.target,locale)}{relation.variantId && <span> · #{relation.variantId}</span>}</a>
</li>)}</ul> : <p class="small-note" lang="en">No direct relationship is listed in the captured base tables. Check the game for special reward or unlock conditions.</p>}</section>
<a class="button secondary" href={href(locale,page.entry.category)}>{ui(locale,'back')}</a>
</aside>
</div>}

    {page.kind === 'guides' && <>{locale !== 'en' && <p class="translation-note">{ui(locale,'englishGuide')}</p>}<div class="guide-grid" lang="en">{guides.map(guide => <a class="guide-card" href={href(locale,`guides/${guide.id}`)}>
<span class="guide-number">{String(guide.data.order).padStart(2,'0')} / {guide.data.section.toUpperCase()}</span>
<h2>{guide.data.title}</h2>
<p>{guide.data.description}</p>
<span>{ui(locale,'next')} <span aria-hidden="true">↗</span>
</span>
</a>)}</div>
</>}
    {page.kind === 'guide' && guide && Content && <div class="article-layout">
<aside class="guide-sidebar" lang="en">
<strong>{ui(locale,'guides')}</strong>
<ul>{guides.map(item => <li>
<a href={href(locale,`guides/${item.id}`)} aria-current={item.id === guide.id ? 'page' : undefined}>{item.data.title}</a>
</li>)}</ul>
</aside>
<article class="prose" lang="en">
<div class="article-meta">
<span class="badge">{guide.data.section}</span>
<span>Android {snapshot.gameVersion}</span>
</div>{locale !== 'en' && <p class="translation-note" lang={locale}>{ui(locale,'englishGuide')}</p>}<Content />
</article>
</div>}

    {page.kind === 'tools' && <div lang="en">
<div class="notice">These are the existing browser-local tools. Combat and derived-stat calculations remain experimental. They do not import game saves or recommend verified owned-gear builds.</div>
<div class="guide-grid">{tools.map(tool => <a class="guide-card" href={`${base}/${tool.file}.html`}>
<span class="guide-number">{tool.file === 'item-book' ? 'MANUAL TRACKER' : 'EXPERIMENTAL'}</span>
<h2>{tool.title}</h2>
<p>{tool.text}</p>
<span>Open tool <span aria-hidden="true">↗</span>
</span>
</a>)}</div>
<div class="panel" style="margin-top:24px">
<h2>Your local records</h2>
<p>Builds and item-book records stay in this browser. Clearing site data, using a private browsing window or changing devices can remove access to them. Export important records before clearing browser storage.</p>
<p>For a reliable comparison today, use the reference and your actual battle results. The shared validated evaluator and save-assisted recommendations are a later phase.</p>
</div>
</div>}

    {page.kind === 'analysis' && <div lang="en">
<div class="notice">Community reference retained from the earlier wiki. These thresholds/effects are not independently verified for 7.3.1 and do not establish a universal maximum level. <a href={href(locale,'guides/analysis')}>Read the analysis guide.</a>
</div>
<div class="table-scroll">
<table>
<caption class="sr-only">Retained community analysis observations</caption>
<thead>
<tr>
<th scope="col">Level</th>
<th scope="col">Corrosion</th>
<th scope="col">Cost</th>
<th scope="col">Total</th>
<th scope="col">Weapon</th>
<th scope="col">Armor</th>
<th scope="col">Ring</th>
</tr>
</thead>
<tbody>{analysisNotes.map(row => <tr>
<th scope="row">{row.level}</th>
<td>{row.corrosion}</td>
<td>{row.cost}</td>
<td>{row.total}</td>
<td>{row.weapon}</td>
<td>{row.armor}</td>
<td>{row.ring}</td>
</tr>)}</tbody>
</table>
</div>
</div>}

    {page.kind === 'dungeon-codes' && <div lang="en">
<div class="notice">Retained community code list, last recorded {dungeonCodes._meta.lastUpdated}. Codes and descriptions are not revalidated for 7.3.1. Copy unusual characters exactly; check the actual dungeon preview in the game.</div>
<div class="table-scroll">
<table>
<caption class="sr-only">Community dungeon codes</caption>
<thead>
<tr>
<th scope="col">Dungeon</th>
<th scope="col">Long code</th>
<th scope="col">Short code</th>
<th scope="col">Starting monster</th>
<th scope="col">Listed floors</th>
</tr>
</thead>
<tbody>{dungeonCodes.keys.filter(code => code.longKey || code.shortKey).map(code => <tr>
<th scope="row">{code.dungeon}</th>
<td>
<code>{code.longKey}</code>
</td>
<td>
<code>{code.shortKey}</code>
</td>
<td>
<a href={entryHref({ category:'monsters',id:code.startingMonster },locale)}>{entryName({ category:'monsters',id:code.startingMonster },locale)}</a>
</td>
<td>{code.floors}</td>
</tr>)}</tbody>
</table>
</div>
</div>}

    {page.kind === 'coverage' && <div lang="en">
<p>What this wiki knows, where it comes from, and how to read the parts that still need verification.</p>
<div class="coverage-grid">
<section class="panel">
<span class="badge">Captured game data</span>
<h2>Android {snapshot.gameVersion} · build {snapshot.build}</h2>
<p>Public tables and game text captured from the installed Android app on {snapshot.capturedAt}. Counts below come from the records used to generate this site, including late-game entries.</p>
<ul class="list-links">{categories.map(category => <li>
<a href={href(locale,category)}>{ui(locale,category)}</a>: {catalog(category).length}</li>)}</ul>
<p>{snapshot.tables.customs.records} individual ability/level records are displayed on {catalog('enchantments').length} grouped pages. {translationRows} translation rows include {duplicateTranslationKeys} duplicate keys; the final game row is used consistently.</p>
</section>
<section class="panel">
<span class="badge">Editorial guidance</span>
<h2>Learn before you optimize</h2>
<p>Guides explain the adventure loop and connect the reference. Authored prose is English. The ten language interfaces translate navigation, search, entity names and game effect text; they do not imply fully translated guides.</p>
<p>Translations come from the game's own text and can contain wording differences. Stable game IDs keep links and relationships the same across languages.</p>
<a class="text-link" href={href(locale,'guides/getting-started')}>Beginner walkthrough ↗</a>
</section>
<section class="panel">
<span class="badge">Community observations</span>
<h2>Useful, with a clear source</h2>
<p>Earlier build strategies, combat formulas, progression and material notes, boss notes, the analysis table and dungeon codes are retained as community references. Exact phase thresholds, formula/cap claims and code outcomes are not established by the current base data.</p>
<p>Special boss placement, random dungeon generation, repeating Tomb groups and mode-specific mechanics can live outside the fixed encounter tables. A catalog entry is not a complete executable specification.</p>
</section>
<section class="panel">
<span class="badge">Experimental tools</span>
<h2>Predictions need validation</h2>
<p>Existing calculators use older and incomplete models. Their outputs are not a verified 7.3.1 clear chance or best-build ranking. No save upload or native preset editing is enabled in this wiki release.</p>
<a class="text-link" href={href(locale,'tools')}>Read tool limitations ↗</a>
</section>
</div>
<section class="panel">
<h2>What changed in the captured data</h2>
<p>Compared with the earlier 6.3.4-labelled snapshot: equipment, ability and fixed-dungeon definitions are identical; material 200 was added; eleven monster EXP values changed; the game translation table grew from 1,301 to 1,470 rows. Matching tables do not prove unchanged combat rules.</p>
<h2>Corrections and official sources</h2>
<ul class="list-links">
<li>
<a href="https://play.google.com/store/apps/details?id=jp.haappss.whipper">Official Android game listing</a>
</li>
<li>
<a href="https://apps.apple.com/us/app/whipper-idle-rpg/id1602383020">Official iOS feature/version history</a> (not an Android release timeline)</li>
<li>
<a href="https://github.com/JayMcArthur/Whipper-IdleRPG/issues">Report a wiki correction</a> with page, platform, game version and observed behavior. Do not attach private player saves.</li>
</ul>
</section>
</div>}
  </div>}
</Wiki>
